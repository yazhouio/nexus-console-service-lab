{
  "id": "kubeeye",
  "version": "2.0.0",
  "entry": "/plugins/kubeeye/2.0.0/",
  "hostApi": "kubesphere.console@1",
  "requires": [
    "kubesphere.cluster@2",
    "routes.query@1",
    "routes.navigate@1"
  ],
  "provides": [],
  "permissions": [
    "cluster.read",
    "routes.query",
    "routes.navigate"
  ],
  "surfaces": [
    {
      "id": "overview"
    }
  ],
  "contributions": {
    "routes": [
      {
        "id": "kubeeye-overview-route",
        "point": {
          "ownerPluginId": "console-core",
          "id": "routes",
          "contractMajor": 1
        },
        "path": "/kubeeye",
        "surfaceId": "overview",
        "layout": {
          "width": "full"
        },
        "initialParameters": {
          "view": "route"
        }
      },
      {
        "id": "node-alert-messages",
        "parentRouteId": "node-detail",
        "point": {
          "ownerPluginId": "cluster",
          "id": "node.children",
          "contractMajor": 1
        },
        "path": "alert-messages",
        "surfaceId": "overview",
        "initialParameters": {
          "view": "node-alerts"
        }
      }
    ],
    "extensions": [
      {
        "id": "kubeeye-overview-card",
        "kind": "surface",
        "label": "KubeEye Card",
        "initiallySelected": false,
        "point": {
          "ownerPluginId": "console-core",
          "id": "home.cards",
          "contractMajor": 1
        },
        "surfaceId": "overview"
      },
      {
        "id": "kubeeye-unused",
        "kind": "surface",
        "point": {
          "ownerPluginId": "console-core",
          "id": "unavailable",
          "contractMajor": 1
        },
        "surfaceId": "overview"
      }
    ],
    "navigation": [
      {
        "id": "kubeeye-overview-navigation",
        "point": {
          "ownerPluginId": "console-core",
          "id": "primary-navigation",
          "contractMajor": 1
        },
        "label": "KubeEye",
        "routeId": "kubeeye-overview-route",
        "order": 200
      },
      {
        "id": "node-alert-navigation",
        "label": "Alerts",
        "parentId": "node-navigation",
        "point": {
          "ownerPluginId": "cluster",
          "id": "node.navigation",
          "contractMajor": 1
        },
        "routeId": "node-alert-messages"
      }
    ]
  }
}

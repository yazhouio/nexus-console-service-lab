{
  "name": "@nexus/example-restricted-plugin",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --experimental-strip-types build-manifest.mjs && rspack build --mode production",
    "dev": "rspack serve --mode development",
    "typecheck": "tsc --noEmit",
    "dev:preview": "NEXUS_STANDALONE_PREVIEW=true rspack serve --mode development"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "@nexus/plugin-runtime": "workspace:*",
    "@nexus/cluster-api": "workspace:*",
    "@nexus/console-core-api": "workspace:*"
  },
  "devDependencies": {
    "@rspack/cli": "catalog:",
    "@rspack/core": "catalog:",
    "@rspack/dev-server": "catalog:",
    "@rspack/plugin-react-refresh": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react-refresh": "catalog:",
    "typescript": "catalog:",
    "@nexus/design-tokens": "workspace:*"
  },
  "exports": {
    "./manifest.json": "./manifest.json",
    "./manifest-v2.json": "./manifest-v2.json"
  }
}

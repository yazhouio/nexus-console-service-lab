{
  "name": "nexus-plugin-runtime-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.1+sha512.3c14c15408d1489d350f8ed7f93361d26cc707054f6849a4eea3bb7407ff4fe4564b413a1c421a773a176ab1168a8df1c7d548f2cd0dc7d344f58c4e680a5b18",
  "engines": {
    "node": ">=24.14.1 <25",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev:docs": "pnpm --filter @nexus/docs dev",
    "build": "pnpm -r --if-present build",
    "build:docs": "pnpm --filter @nexus/docs build",
    "dev:host": "pnpm build:public && pnpm --filter @nexus/console dev",
    "dev:plugin": "pnpm --filter @nexus/example-restricted-plugin dev",
    "preview:docs": "pnpm --filter @nexus/docs preview",
    "test": "node --test scripts/test/*.test.mjs && pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm check:boundaries && pnpm build:public && tsc -p scripts/plugin-contract/tsconfig.json && pnpm -r --if-present typecheck",
    "check:node": "node scripts/check-node-version.mjs",
    "check:plugin-contract": "node scripts/check-plugin-contract.mjs",
    "build:routing-validation": "pnpm build:public && pnpm --filter @nexus/example-restricted-plugin build && pnpm --filter @nexus/ui-composition-fixtures build && NEXUS_ROUTING_VALIDATION=true NEXUS_TEST_FIXTURES=true NEXUS_BUILD_VERSION=routing-validation pnpm --filter @nexus/console build",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts",
    "routing:measure": "node scripts/measure-routing.mjs",
    "routing:smoke": "node scripts/routing-smoke.mjs",
    "build:routing-release": "node scripts/check-node-version.mjs && pnpm build:public && NEXUS_REQUIRE_ROUTING_EVIDENCE=true pnpm --filter @nexus/console build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "generate:plugin-contract": "node scripts/generate-plugin-contract.mjs",
    "test:styling-compilers": "pnpm --filter @nexus/plugin-runtime build && node scripts/validate-styling-compilers.mjs",
    "test:styling": "pnpm build:routing-validation && pnpm test:e2e:preview e2e/plugin-styling.spec.ts && pnpm test:styling-compilers",
    "test:externalization": "node scripts/validate-externalization.mjs",
    "build:public": "pnpm --filter @nexus/browser-host... --filter @nexus/console-core... --filter @nexus/cluster-api build"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@playwright/test": "catalog:",
    "@stylexjs/babel-plugin": "0.19.0",
    "@stylexjs/stylex": "0.19.0",
    "@tailwindcss/node": "4.3.3",
    "lightningcss": "1.33.0",
    "postcss": "8.5.26",
    "postcss-selector-parser": "7.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:"
  }
}

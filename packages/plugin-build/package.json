{
  "name": "@feforgejs/plugin-build",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yazhouio/nexus-console-service-lab.git",
    "directory": "packages/plugin-build"
  },
  "files": [
    "*.cjs",
    "*.mjs",
    "*.mts"
  ],
  "type": "module",
  "exports": {
    "./artifact-css-loader": "./artifact-css-loader.cjs",
    "./reject-unmanaged-css": "./reject-unmanaged-css.cjs",
    "./check-css": {
      "types": "./check-plugin-css.d.mts",
      "import": "./check-plugin-css.mjs"
    },
    "./closure": {
      "types": "./artifact-css-closure.d.mts",
      "import": "./artifact-css-closure.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "lightningcss": "1.33.0",
    "postcss": "8.5.26",
    "postcss-selector-parser": "7.1.0"
  },
  "peerDependencies": {
    "@rsbuild/core": "2.2.2"
  }
}

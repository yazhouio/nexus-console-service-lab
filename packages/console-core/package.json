{
  "name": "@feforgejs/console-core",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yazhouio/nexus-console-service-lab.git",
    "directory": "packages/console-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },

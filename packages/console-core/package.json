    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css"
  },
  "dependencies": {
    "@feforgejs/console-core-api": "workspace:*"
  },
  "devDependencies": {
    "@feforgejs/plugin-runtime": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@feforgejs/plugin-runtime": "^0.1.0",
    "react": "^19.0.0"
  }
}
